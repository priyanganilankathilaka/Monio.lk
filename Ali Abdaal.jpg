n","canonicalBaseUrl":"/post/Ugkxt9glA55yAqkeZe13iqbXWRmK5Nh4S31o"}},"loggingDirectives":{"trackingParams":"CMkBEMShAxgIIhMIxMSjlfL0lgMVNjGDAx3FViGx","visibility":{"types":"12"}}}},{"postRenderer":{"postId":"Ugkx_PKTPSZ1CFgHQbVVvF1fDxfQW91pJtW3","authorText":{"runs":[{"text":"Ali Abdaal","navigationEndpoint":{"clickTrackingParams":"CL8BEMShAxgJIhMIxMSjlfL0lgMVNjGDAx3FViGxygEEyV7vnw==","commandMetadata":{"webCommandMetadata":{"url":"/@aliabdaal","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCoOae5nYA7VqaXzerajD0lg","canonicalBaseUrl":"/@aliabdaal"}}}],"accessibility":{"accessibilityData":{"label":"Ali Abdaal"}}},"authorThumbnail":{"thumbnails":[{"url":"//yt3.googleusercontent.com/ytc/AIdro_m2xx6mCZwsyjARnkwBKJxEv0FqGxGS2NwWNkjWH__Smw=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32},{"url":"//yt3.googleusercontent.com/ytc/AIdro_m2xx6mCZwsyjARnkwBKJxEv0FqGxGS2NwWNkjWH__Smw=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"//yt3.googleusercontent.com/ytc/AIdro_m2xx6mCZwsyjARnkwBKJxEv0FqGxGS2NwWNkjWH__Smw=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76}],"accessibility":{"accessibilityData":{"label":"Ali Abdaal"}}},"authorEndpoint":{"clickTrackingParams":"CL8BEMShAxgJIhMIxMSjlfL0lgMVNjGDAx3FViGxygEEyV7vnw==","commandMetadata":{"webCommandMetadata":{"url":"/@aliabdaal","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCoOae5nYA7VqaXzerajD0lg","canonicalBaseUrl":"/@aliabdaal"}},"contentText":{"runs":[{"text":"Hey gang - would love your help with something:  \n\nWe’re on the hunt for a growth co-founder for our software studio - and I’d love your help in finding the right person 😊\n\nBasically: We’re building a suite of software products across productivity, personal development and the creator economy. The mission is to help 100 million people take back control of their time, energy and focus, and make progress on the goals that actually matter to them.\n\nWe’re 18 months in, bootstrapped, profitable, doing $1m+ ARR, with a large aligned audience of 10M+ across socials, 100,000+ users on one consumer product, and a B2B product already used by teams at Notion, Superhuman, Wispr Flow, Morning Brew and others. Our small team already has very strong product, engineering and design. \n\nOur missing piece is a proper growth co-founder: double-digit equity, double-digit profit share from day one, high autonomy, fully remote, and a lot of distribution already in place. \n\nThe person we’re looking for probably isn’t a traditional VP of Growth. They’re more likely to be a hands-on, internet-native operator who’s personally made something grow recently - through content, creator partnerships, UGC, viral ads, weird internet experiments, or anything else that actually moves the needle.\n\nIf someone came to mind while reading this, please could you send them this link? \n\nMore info: www.aliabdaal.com/jobs (or DM me on IG) \n\nThank you 🙏"}]},"publishedTimeText":{"runs":[{"text":"3 months ago","navigationEndpoint":{"clickTrackingParams":"CL8BEMShAxgJIhMIxMSjlfL0lgMVNjGDAx3FViGxygEEyV7vnw==","commandMetadata":{"webCommandMetadata":{"url":"/post/Ugkx_PKTPSZ1CFgHQbVVvF1fDxfQW91pJtW3","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":247244,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEpost_detail","params":"wgNaEhhVQ29PYWU1bllBN1ZxYVh6ZXJhakQwbGcaJFVna3hfUEtUUFNaMUNGZ0hRYlZWdkYxZkR4ZlFXOTFwSnRXM1oYVUNvT2FlNW5ZQTdWcWFYemVyYWpEMGxn","canonicalBaseUrl":"/post/Ugkx_PKTPSZ1CFgHQbVVvF1fDxfQW91pJtW3"}}}]},"voteCount":{"accessibility":{"accessibilityData":{"label":"262 likes"}},"simpleText":"262"},"voteStatus":"INDIFFERENT","actionButtons":{"commentActionButtonsRenderer":{"likeButton":{"toggleButtonRenderer":{"style":{"styleType":"STYLE_TEXT"},"size":{"sizeType":"SIZE_DEFAULT"},"isToggled":false,"isDisabled":false,"defaultIcon":{"iconType":"LIKE"},"accessibility":{"label":"Like this pos